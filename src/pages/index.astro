        </div>
        <!-- TBD -->
        <!-- <div class='icon-list'>
          <i class='nes-icon coin is-large'></i>
          <i class='nes-icon coin is-large'></i>
          <i class='nes-icon coin is-large'></i>
        </div> -->
      </section>

      <section class='section' id='resume'>
        <h1 class='title'>Resume</h1>
      </section>

      <section class='section' id='contact'>
        <h1 class='title'>Contact</h1>
      </section>
    </main>
    <footer class='footer'>All rights reserved</footer>
  </body>
</html>
