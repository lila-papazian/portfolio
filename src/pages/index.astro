---
import Coins from "../components/Coins.astro";
import { stack } from "../data/stack";

function getRandomValue(min: number, max: number) {
  const minCeiled = Math.ceil(min);
  const maxFloored = Math.floor(max);
  return Math.floor(Math.random() * (maxFloored - minCeiled + 1) + minCeiled); // Both max and min are inclusive
}

const hours = new Date().getHours();
const magicValue = Math.min((hours / 24) * 100 + 5, 100); // Min level for magic is 5

const teaValue = getRandomValue(70, 100);

const wtfValue = getRandomValue(10, 100);

const isSuccess = (value: number) => value >= 75;
const isWarning = (value: number) => value < 75 && value >= 45;
const isError = (value: number) => value < 45;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>Lila Papazian - Senior Frontend Engineer | Web3 Developer</title>
    <meta
      name="description"
      content="Senior Frontend Engineer with 7 years of React experience transitioning to Web3. Building Finna, a multi-currency financial dashboard. Based in Argentina."
    />
    <meta
      name="keywords"
      content="Lila Papazian, Frontend Engineer, Web3 Developer, React Developer, Next.js, Blockchain, Argentina, Finna"
    />
    <meta name="author" content="Lila Papazian" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lilapapazian.dev/" />
    <meta
      property="og:title"
      content="Lila Papazian - Senior Frontend Engineer | Web3 Developer"
    />
    <meta
      property="og:description"
      content="Senior Frontend Engineer with 7 years of React experience transitioning to Web3. Building Finna, a multi-currency financial dashboard."
    />
    <meta
      property="og:image"
      content="https://lilapapazian.dev/assets/og-image.png"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lilapapazian" />
    <meta
      name="twitter:title"
      content="Lila Papazian - Senior Frontend Engineer | Web3 Developer"
    />
    <meta
      name="twitter:description"
      content="Senior Frontend Engineer with 7 years of React experience transitioning to Web3. Building Finna."
    />
    <meta
      name="twitter:image"
      content="https://lilapapazian.dev/assets/og-image.png"
    />

    <link rel="canonical" href="https://lilapapazian.dev/" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Lila Papazian",
        "jobTitle": "Senior Frontend Engineer",
        "url": "https://lilapapazian.dev",
        "sameAs": [
          "https://twitter.com/lilapapazian",
          "https://github.com/lila-papazian",
          "https://www.linkedin.com/in/lila-papazian/"
        ],
        "knowsAbout": [
          "React",
          "Next.js",
          "Web3",
          "TypeScript",
          "Blockchain Development"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "Argentina"
        }
      }
    </script>

    <!-- Critical CSS -->
    <style>
      body {
        background-attachment: fixed;
        background-color: #fafafa;
        background-image: url("/assets/bg.webp");
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }
    </style>

    <!-- Preloads -->
    <link rel="preload" href="/assets/bg.webp" as="image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://unpkg.com/nes.css@latest/css/nes.min.css"
      rel="stylesheet"
    />
    <link href="/styles/reset.css" rel="stylesheet" />
    <link href="/styles/index.css" rel="stylesheet" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script src="../scripts/interactive-buttons.js"></script>
    <script src="../scripts/secret-level.js"></script>
  </head>
  <body tabindex="0">
    <header class="header">
      <div>
        <button class="nes-btn" id="toggle-sound" aria-label="Toggle sound">
          <img
            src="/assets/high-volume.png"
            width="24px"
            alt=""
            id="sound-icon"
          />
        </button>
      </div>
      <div>
        <button class="nes-btn" id="go-to-stats">ABOUT ME</button>
        <button class="nes-btn is-primary" id="go-to-projects"
          >CURRENT QUEST</button
        >
        <button class="nes-btn" id="go-to-contact">LET'S TALK</button>
      </div>
    </header>
    <main class="main">
      <section class="section first-section">
        <div class="title-section">
          <h1 class="custom-title">Lila Papazian</h1>
          <h2 class="custom-subtitle" style="margin-top: 0.5em;">
            Senior Frontend Engineer React, Next.js, Scalable UIs
          </h2>
          <h2 class="custom-subtitle">
            <span class="fun-line">90’s kid at heart</span>
          </h2>
        </div>

        <div class="continue-section">
          <h3 class="subtitle">CONTINUE?</h3>
          <div class="button-group">
            <button class="nes-btn" id="start-game">YES</button>
            <button class="nes-btn" id="game-over">NO</button>
          </div>
        </div>
      </section>

      <section class="section two-part-section" id="stats">
        <div
          class="nes-container is-rounded is-dark with-title stats-container"
        >
          <p class="title" style="width: fit-content; font-size: 24px">
            ABOUT ME
          </p>
          <div class="container">
            <div class="progress-container">
              <span>Skills</span>
              <div class="skill">
                <span class="nes-text" id="magic-label">Magic</span>
                <progress
                  aria-labelledby="magic-label"
                  class:list={[
                    "nes-progress progress-dark-bg",
                    { "is-success": isSuccess(magicValue) },
                    { "is-warning": isWarning(magicValue) },
                    { "is-error": isError(magicValue) },
                  ]}
                  value={magicValue}
                  max="100"></progress>
              </div>
              <div class="skill">
                <span class="nes-text" id="tea-label">Tea Brewing</span>
                <progress
                  aria-labelledby="tea-label"
                  class:list={[
                    "nes-progress progress-dark-bg",
                    { "is-success": isSuccess(teaValue) },
                    { "is-warning": isWarning(teaValue) },
                    { "is-error": isError(teaValue) },
                  ]}
                  value={teaValue}
                  max="100"></progress>
              </div>
              <div class="skill">
                <a
                  href="https://www.osnews.com/story/19266/wtfsm/"
                  aria-label="WTFs per minute explanation"
                  target="_blank"
                  class="nes-text"
                  id="wtf-label"
                  style="color: white; text-decoration: underline;"
                  >WTFs / minute</a
                >
                <progress
                  aria-labelledby="wtf-label"
                  class:list={[
                    "nes-progress progress-dark-bg",
                    { "is-success": isError(wtfValue) },
                    { "is-warning": isWarning(wtfValue) },
                    { "is-error": isSuccess(wtfValue) },
                  ]}
                  value={wtfValue}
                  max="100"></progress>
              </div>
            </div>
            <div class="tools-container">
              <span>Stack</span>
              <div class="lists">
                <ul class="nes-list is-circle white-bullet">
                  {stack.core.map((item) => <li>{item}</li>)}
                  ---
                  {stack.state.map((item) => <li>{item}</li>)}
                  ---
                  {stack.styling.map((item) => <li>{item}</li>)}
                  ---
                  {
                    stack.learning.map((item) => (
                      <li class="nes-text is-warning">{item}</li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
        <Coins />
      </section>

      <section class="section two-part-section" id="projects">
        <div class="nes-container is-rounded is-dark with-title">
          <p class="title" style="width: fit-content; font-size: 24px">
            CURRENT QUEST
          </p>
          <div class="tools-container">
            <div class="quest-info">
              <h3 class="nes-text is-warning">🚀 Transitioning to Web3</h3>
              <p>
                Senior Frontend Engineer (7 years React) learning blockchain
                development. Currently building tools that solve real problems
                in multi-currency markets.
              </p>
            </div>

            <article class="article">
              <h2>
                <a
                  href="https://twitter.com/finna_app"
                  aria-label="Finna - Financial Dashboard Twitter page"
                >
                  Finna - Financial Dashboard
                </a>
              </h2>
              <p>In Progress • 2025</p>
              <div class="lists">
                <ul class="nes-list is-circle white-bullet">
                  <li>
                    Multi-currency financial tracking built for Argentina and
                    similar markets
                  </li>
                  <li>
                    Handles pesos/USD/crypto, credit card installments,
                    Interactive Brokers integration
                  </li>
                  <li>
                    Tech: Next.js, Astro, TypeScript, ethers.js, Web3 wallet
                    integration
                  </li>
                </ul>
              </div>
            </article>

            <div class="quest-info">
              <h3 class="nes-text">📚 Currently Learning</h3>
              <div class="lists">
                <ul class="nes-list is-circle white-bullet">
                  <li>
                    Web3 development (ethers.js, wallet integration, DeFi)
                  </li>
                  <li>Next.js app router & server components</li>
                  <li>Astro for performant landing pages</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <Coins />
      </section>

      <section class="section" id="contact">
        <div class="nes-container is-rounded is-dark with-title">
          <p class="title" style="width: fit-content; font-size: 24px">
            LET'S TALK
          </p>
          <div class="icon-list" style="padding: 1em 0;">
            <a
              href="https://www.linkedin.com/in/lila-papazian/"
              class="contact"
              aria-label="LinkedIn profile - lila-papazian"
            >
              <i class="nes-icon linkedin is-medium" aria-hidden="true"></i>
              <span class="link-text">/lila-papazian</span>
            </a>
            <a
              href="https://github.com/lila-papazian/"
              class="contact"
              aria-label="GitHub profile - lila-papazian"
            >
              <i class="nes-icon github is-medium" aria-hidden="true"></i>
              <span class="link-text">/lila-papazian</span>
            </a>
            <a
              href="mailto:lilapapazian@gmail.com"
              class="contact"
              aria-label="Email lilapapazian at gmail dot com"
            >
              <i class="nes-icon gmail is-medium" aria-hidden="true"></i>
              <span class="link-text">lilapapazian@gmail.com</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer class="footer">2024 Lila Papazian. All pixels reserved.</footer>
  </body>
</html>
