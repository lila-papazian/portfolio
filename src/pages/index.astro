---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>Lila Papazian — Product Engineer</title>

    <meta
      name="description"
      content="Lila Papazian is a frontend-rooted Product Engineer focused on UX, product thinking, and craft."
    />
    <meta name="author" content="Lila Papazian" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lilapapazian.dev/" />
    <meta property="og:title" content="Lila Papazian — Product Engineer" />
    <meta
      property="og:description"
      content="Frontend-rooted Product Engineer focused on UX, product thinking, and craft."
    />
    <meta
      property="og:image"
      content="https://lilapapazian.dev/assets/og-image.png"
    />

    <link rel="canonical" href="https://lilapapazian.dev/" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Lila Papazian",
        "url": "https://lilapapazian.dev/",
        "jobTitle": "Product Engineer",
        "sameAs": [
          "https://github.com/lila-papazian",
          "https://www.linkedin.com/in/lila-papazian/"
        ]
      }
    </script>
  </head>
  <body class="bg-dark text-white min-h-svh p-4 flex flex-col gap-4">
    <header
      id="navbar"
      class="inset-x-0 top-0 z-50 px-4
    transition-all duration-500 ease-out"
    >
      <nav class="flex items-center justify-between px-6 py-4">
        <a href="/" id="nav-name" class="font-sentient font-bold text-xl">
          LILA PAPAZIAN
        </a>

        <ul id="nav-links" class="flex flex-row justify-end gap-4">
          <li>
            <a
              href="#"
              class="underline-offset-4 decoration-2 decoration-accent hover:underline"
            >
              work
            </a>
          </li>

          <li>
            <a
              href="#"
              class="underline-offset-4 decoration-2 decoration-accent hover:underline"
            >
              experience
            </a>
          </li>

          <li>
            <a
              href="#"
              class="underline-offset-4 decoration-2 decoration-accent hover:underline after:content-['_↗'] hover:after:text-accent"
            >
              reach out
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main class="flex-1 flex flex-col gap-4">
      <section
        id="hero"
        class="flex flex-col pb-8 justify-center gap-8 border-b border-accent/25"
      >
        <div>
          <h1 class="font-sentient text-8xl font-bold">LILA PAPAZIAN</h1>

          <h2>
            Senior Frontend Engineer — product thinking, architectural
            decisions, shipped at scale
          </h2>
        </div>
        <div class="flex flex-row gap-4 justify-center md:justify-start">
          <button
            class="text-[0.8em] uppercase cursor-pointer border-2 border-black
              bg-accent px-5 py-3
              text-white
              shadow-[6px_6px_0_#000]
              transition-[transform,box-shadow] duration-100
              hover:translate-x-[6px]
              hover:translate-y-[6px]
              hover:shadow-none"
            >View my work</button
          >
          <button
            class="text-[0.8em] uppercase cursor-pointer border-2 border-accent
              px-5 py-3
              text-white
              hover:bg-accent
              hover:border-black
              hover:text-white shadow-[6px_6px_0_#000]
              transition-[transform,box-shadow] duration-100
              hover:translate-x-[6px]
              hover:translate-y-[6px]
              hover:shadow-none"
          >
            Reach out
          </button>
        </div>
      </section>
    </main>
    <footer>footer</footer>
    <script is:inline>
      const navbar = document.querySelector("#navbar");
      const navName = document.querySelector("#nav-name");
      const navLinks = document.querySelector("#nav-links");
      const hero = document.querySelector("#hero");

      if (navbar && navName && navLinks && hero) {
        const desktopQuery = window.matchMedia("(min-width: 768px)");

        const setNavbarState = (heroFinished) => {
          const isDesktop = desktopQuery.matches;

          // Desktop: navbar becomes fixed after the hero.
          navbar.classList.toggle("fixed", heroFinished && isDesktop);
          navbar.classList.toggle("top-0", heroFinished && isDesktop);

          if (heroFinished) {
            // Animate both elements in.
            navName.classList.remove("opacity-0", "translate-y-2");
            navName.classList.add(
              "opacity-100",
              "translate-y-0",
              "transition-[opacity,transform]",
              "duration-700",
              "ease-out",
            );

            navLinks.classList.remove("opacity-0", "translate-y-2");
            navLinks.classList.add(
              "opacity-100",
              "translate-y-0",
              "transition-[opacity,transform]",
              "duration-700",
              "delay-75",
              "ease-out",
            );
          } else {
            // Return to the initial state.
            navName.classList.remove("opacity-100", "translate-y-0");
            navName.classList.add("opacity-0", "translate-y-2");

            navLinks.classList.remove("opacity-100", "translate-y-0");
            navLinks.classList.add("opacity-0", "translate-y-2");
          }
        };

        // Initial state: visible while the hero is on screen.
        navName.classList.add(
          "transition-[opacity,transform]",
          "duration-700",
          "ease-out",
        );

        navLinks.classList.add(
          "transition-[opacity,transform]",
          "duration-700",
          "ease-out",
        );

        const observer = new IntersectionObserver(
          ([entry]) => {
            const heroFinished =
              !entry.isIntersecting && entry.boundingClientRect.bottom <= 0;

            setNavbarState(heroFinished);
          },
          {
            threshold: 0,
          },
        );

        observer.observe(hero);

        desktopQuery.addEventListener("change", () => {
          observer.unobserve(hero);
          observer.observe(hero);
        });
      }
    </script>
  </body>
</html>
