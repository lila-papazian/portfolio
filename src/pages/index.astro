                  max='100'></progress>
              </div>
              <div class='skill'>
                <a
                  href='https://www.osnews.com/story/19266/wtfsm/'
                  class='nes-text'
                  style='color: white; text-decoration: underline;'
                  >WTFs / minute</a
                >
                <progress
                  class:list={[
                    "nes-progress",
                    { "is-success": isSuccess(wtfValue) },
                    { "is-warning": isWarning(wtfValue) },
                    { "is-error": isError(wtfValue) },
                  ]}
                  value={wtfValue}
