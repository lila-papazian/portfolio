              </div>
            </div>
            <div class='tools-container'>
              <span>Tools</span>
              <div class='lists'>
                <ul class='nes-list is-circle'>
                  <li>React</li>
                  <li>React Query</li>
                  <li>Zustand</li>
                  <li>Redux</li>
                  --- <li>JavaScript</li>
                  <li>TypeScript</li>
                  --- <li>SaSS</li>
                  <li>Tailwind</li>
                  <li>Styled Components</li>
                  --- <li>Next.js</li><li>Astro</li>
