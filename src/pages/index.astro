---
// Generate random daily value (with seed based on date)
function getRandomValue(min: number, max: number) {
  const today = new Date().toDateString();
  let seed = today.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0);
  return Math.floor(Math.sin(seed) * (max - min) + min);
}

const hours = new Date().getHours();
const magicValue = Math.min((hours / 24) * 100, 100);

// Tea Brewing: set randomly each day
const teaValue = getRandomValue(50, 100); // Tea skill is always pretty high

// WTF/minutes: fluctuates daily
const wtfValue = getRandomValue(0, 100);

const isSuccess = (value: number) => value >= 75;
const isWarning = (value: number) => value < 75 && value >= 45;
const isError = (value: number) => value < 45;
---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <link rel='stylesheet' href='/src/reset.css' />
