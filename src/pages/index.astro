              <div class='skill'>
                <span class='nes-text'>Magic</span>
                <progress
                  class:list={[
                    "nes-progress",
                    { "is-success": isSuccess(magicValue) },
                    { "is-warning": isWarning(magicValue) },
                    { "is-error": isError(magicValue) },
