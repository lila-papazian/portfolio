---
import Coins from "../components/Coins.astro";
function getRandomValue(min: number, max: number) {
  const minCeiled = Math.ceil(min);
  const maxFloored = Math.floor(max);
  return Math.floor(Math.random() * (maxFloored - minCeiled + 1) + minCeiled); // The maximum is inclusive and the minimum is inclusive
}

const hours = new Date().getHours();
const magicValue = Math.min((hours / 24) * 100, 100);

const teaValue = getRandomValue(70, 100); // Tea skill is always pretty high

const wtfValue = getRandomValue(0, 100);

const isSuccess = (value: number) => value >= 75;
const isWarning = (value: number) => value < 75 && value >= 45;
const isError = (value: number) => value < 45;
---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <title>Lila Papazian</title>

    <!-- Critical CSS -->
    <style>
      body {
        background-attachment: fixed;
        background-color: #fafafa;
        background-image: url("/bg.webp");
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }
    </style>

    <!-- Preloads -->
    <link rel='preload' href='/bg.webp' as='image' />
    <link
      rel='preload'
      href='https://fonts.googleapis.com/css?family=Press+Start+2P'
      as='style'
      onload="this.rel='stylesheet'"
    />

    <!-- Stylesheets -->
    <link rel='stylesheet' href='../src/reset.css' />
    <link
      href='https://unpkg.com/nes.css@latest/css/nes.min.css'
      rel='stylesheet'
    />
    <link rel='stylesheet' href='../src/index.css' />

    <script src='./../../src/interactive-buttons.js' defer></script>
  </head>
  <body tabindex="0">
    <header class='header'>
      <div>
        <button class='nes-btn' id="toggle-sound"><img src='/high-volume.png' width='24px' alt="Sound On" id="sound-icon" /></button>
      </div>
      <div>
        <button class='nes-btn' id='go-to-stats'>About Me</button>
        <button class='nes-btn' id='go-to-resume'>CV/Resume</button>
        <button class='nes-btn' id='go-to-contact'>Let's talk</button>
      </div>
    </header>
    <main class='main'>
      <section class='section first-section'>
        <div class='title-section'>
          <h1 class='custom-title'>Lila Papazian</h1>
          <h2 class='custom-subtitle'>Creative web developer, 90's kid.</h2>
        </div>

        <div class='continue-section'>
          <h3 class='subtitle'>CONTINUE?</h3>
          <div class='button-group'>
            <button class='nes-btn' id='start-game'>YES</button>
            <button class='nes-btn' id='game-over'>NO</button>
          </div>
        </div>
      </section>

      <section class='section two-part-section' id='stats'>
        <div
          class='nes-container is-rounded is-dark with-title stats-container'
        >
          <p class='title' style='width: fit-content; font-size: 24px'>
            ABOUT ME
          </p>
          <div class='container'>
            <div class='progress-container'>
              <span>Skills</span>
              <div class='skill'>
                <span class='nes-text'>Magic</span>
                <progress
                  class:list={[
                    "nes-progress progress-dark-bg",
                    { "is-success": isSuccess(magicValue) },
                    { "is-warning": isWarning(magicValue) },
                    { "is-error": isError(magicValue) },
                  ]}
                  value={magicValue}
                  max='100'></progress>
              </div>
              <div class='skill'>
                <span class='nes-text'>Tea Brewing</span>
                <progress
                  class:list={[
                    "nes-progress progress-dark-bg",
                    { "is-success": isSuccess(teaValue) },
                    { "is-warning": isWarning(teaValue) },
                    { "is-error": isError(teaValue) },
                  ]}
                  value={teaValue}
                  max='100'></progress>
              </div>
              <div class='skill'>
                <a
                  href='https://www.osnews.com/story/19266/wtfsm/'
                  class='nes-text'
                  style='color: white; text-decoration: underline;'
                  >WTFs / minute</a
                >
                <progress
                  class:list={[
                    "nes-progress progress-dark-bg",
                    { "is-success": isError(wtfValue) },
                    { "is-warning": isWarning(wtfValue) },
                    { "is-error": isSuccess(wtfValue) },
                  ]}
                  value={wtfValue}
                  max='100'></progress>
              </div>
            </div>
            <div class='tools-container'>
              <span>Tools</span>
              <div class='lists'>
                <ul class='nes-list is-circle white-bullet'>
                  <li>React</li>
                  <li>React Query</li>
                  <li>Zustand</li>
                  <li>Redux</li>
                  --- <li>JavaScript</li>
                  <li>TypeScript</li>
                  --- <li>SaSS</li>
                  <li>Tailwind</li>
                  <li>Styled Components</li>
                  --- <li>Next.js</li><li>Astro</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <Coins />
      </section>

      <section class='section two-part-section' id='resume'>
        <div class='nes-container is-rounded is-dark with-title'>
          <p class='title' style='width: fit-content; font-size: 24px'>
            RESUME / CV
          </p>
          <div class='icon-list' style='padding: 1em 0;'>
            See it online at:
            <a
              href='https://www.linkedin.com/in/lila-papazian/'
              class='contact'
            >
              <i class='nes-icon linkedin is-medium'></i>
              <p class='link-text'>/lila-papazian</p>
            </a>
            or Download as PDF:

            <a
              href='/public/Lila Papazian CV.pdf'
              download='Lila Papazian - CV'
              class='contact nes-btn'
              >PDF
            </a>
          </div>
          <div class='tools-container'>
            <article class='article'>
              <h1>Frontend Engineer at Blue Alba</h1>
              <p>April 2024 - September 2024</p>

              <div class='lists'>
                <ul class='nes-list is-circle white-bullet'>
                  <li>
                    Develop and integrate new features into web applications
                    using Typescript, React, Zustand and React-Query, ensuring a
                    seamless user experience.
                  </li>
                  <li>
                    Maintain and improve code quality by refactoring and adding
                    comprehensive tests using Jest when feasible (using Working
                    Effectively with Legacy Code by Michael Feathers as guide).
                  </li>
                  <li>
                    Utilize Jest to add unit testing to key frontend functions,
                    focusing on custom hooks to ensure reliability and
                    maintainability.
                  </li>
                  <li>
                    Add components to company-owned component libraries,
                    ensuring seamless integration with Storybook for better
                    documentation and visualization
                  </li>
                </ul>
              </div>
              <div>
                <p>Other tools or technologies used:</p>
                <p>
                  StyledComponents, Material UI, ag-grid, chart.js, Typescript
                </p>
              </div>
            </article>
            <article class='article'>
              <h1>Web Developer at Despegar</h1>
              <p>Oct 2018 - April 2021</p>
              <div class='lists'>
                <ul class='nes-list is-circle white-bullet'>
                  <li>
                    Refactor Angular.js and Javascript legacy code using React
                    with hooks and Typescript.
                  </li>
                  <li>
                    Implement fully styled components from an internal library
                    to avoid duplicating code and maintain branding.
                  </li>
                </ul>
              </div>
              <p>Other tools or technologies used:</p>
              <p>CSS Modules, React Query</p>
            </article>
          </div>
        </div>
        <Coins />
      </section>

      <section class='section' id='contact'>
        <div class='nes-container is-rounded is-dark with-title'>
          <p class='title' style='width: fit-content; font-size: 24px'>
            LET'S TALK
          </p>
          <div class='icon-list' style='padding: 1em 0;'>
            <a
              href='https://www.linkedin.com/in/lila-papazian/'
              class='contact'
            >
              <i class='nes-icon linkedin is-medium'></i>
              <p class='link-text'>/lila-papazian</p>
            </a>
            <a href='https://github.com/lila-papazian/' class='contact'>
              <i class='nes-icon github is-medium'></i>
              <p class='link-text'>/lila-papazian</p>
            </a>
            <a href='mailto:lilapapazian@gmail.com' class='contact'>
              <i class='nes-icon gmail is-medium'></i>
              <p class='link-text'>lilapapazian@gmail.com</p>
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer class='footer'>2024 Lila Papazian. All pixels reserved.</footer>
    <script src='./../../src/secret-level.js' defer></script>
  </body>
</html>
