---
interface Highlight {
  title: string;
  description: string;
}

interface ExperienceCardProps {
  company: string;
  period: string;
  role: string;
  subtitle: string;
  highlights: Highlight[];
  technologies: string[];
}

interface Props {
  experiences: ExperienceCardProps[];
}

const { experiences } = Astro.props;
---

<div class="flex flex-col-reverse gap-6 md:grid md:grid-cols-3">
  {
    experiences.map((exp) => (
      <div class="card bg-transparent border-2 border-accent rounded-none shadow-none hover:border-accent-light hover:shadow-none transition-all duration-150 hover:translate-y-[-2px]">
        <div class="card-header bg-orange-500/10 border-b-2 border-accent px-6 py-4 flex justify-between items-start rounded-none">
          <h3 class="text-lg font-bold uppercase letter-spacing tracking-widest m-0 text-white">
            {exp.company}
          </h3>
          <span class="text-xs text-white/60 uppercase tracking-wide font-semibold">
            {exp.period}
          </span>
        </div>

        <div class="card-body px-6 py-6 flex flex-col gap-4">
          <div>
            <h4 class="text-sm font-bold uppercase tracking-widest text-accent m-0 mb-2">
              {exp.role}
            </h4>
            <p class="text-sm text-white/80 italic m-0 leading-relaxed">{exp.subtitle}</p>
          </div>

          <div class="flex flex-col gap-3 mt-4">
            {exp.highlights.map((highlight) => (
              <div class="flex gap-2">
                <span class="text-accent font-bold flex-shrink-0">→</span>
                <div class="text-xs leading-relaxed text-white/85">
                  <strong class="text-white">{highlight.title}:</strong> {highlight.description}
                </div>
              </div>
            ))}
          </div>

          <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-orange-500/20">
            {exp.technologies.map((tech) => (
              <span class="inline-block bg-orange-500/15 border border-orange-500/30 text-accent px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wide">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .letter-spacing {
    letter-spacing: 0.1em;
  }

  .tracking-widest {
    letter-spacing: 0.1em;
  }
</style>
