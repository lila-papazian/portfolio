---
import "./header-row.css";

interface Props {
  leftTitle: string;
  leftSubtitle: string;
  roleSubtitle: string;
  dateSubtitle: string;
}

const { leftTitle, leftSubtitle, roleSubtitle, dateSubtitle } = Astro.props;
---

<div
  class="border-y-2 border-y-accent/50 flex flex-col sm:flex-row align-center justify-between"
>
  <div class="flex flex-col align-center py-4">
    <span class="text-xs sm:text-sm font-features-['smcp'] uppercase"
      >{leftTitle}</span
    >
    <span class="text-xs sm:text-sm font-features-['smcp'] uppercase"
      >{leftSubtitle}</span
    >

  </div>
  <div class="sm:hidden h-full border border-accent/50"></div>

  <div class="flex flex-col sm:flex-row align-center gap-4 py-4">
    <div class="flex flex-col">
      <span class="text-xs sm:text-sm font-features-['smcp'] text-white/50 uppercase"
        >Role</span
      >
      <span class="text-xs sm:text-sm font-features-['smcp'] uppercase"
        >{roleSubtitle}</span
      >
    </div>
    <div class="h-full border border-accent/50"></div>
    <div class="flex flex-col">
      <span class="text-xs sm:text-sm font-features-['smcp'] uppercase text-white/50"
        >Date</span
      >
      <span class="text-xs sm:text-sm font-features-['smcp'] uppercase"
        >{dateSubtitle}</span
      >
    </div>
  </div>
</div>
